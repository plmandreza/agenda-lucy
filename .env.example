# Modelo das variáveis de ambiente. Os valores de verdade vão na Vercel
# (Settings > Environment Variables). Nunca coloque os valores reais aqui.

# Supabase > Project Settings > Data API (ou API) > Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Secret keys (começa com sb_secret_)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# O mesmo e-mail que você usou ao criar o login da Lucy no Supabase
ADMIN_EMAIL=lucy@exemplo.com

# Opcional: outros endereços que podem usar o servidor (ex.: versão React)
ALLOWED_ORIGINS=
